/* ==================================
   SPECIAL OFFERS
================================== */

.special-offers{
padding:120px 0;
background:
linear-gradient(
rgba(248,245,236,.92),
rgba(248,245,236,.92)
),
url("https://images.unsplash.com/photo-1493246507139-91e8fad9978e?q=80&w=1920&auto=format&fit=crop");
background-size:cover;
background-position:center;
}

.offers-header{
text-align:center;
max-width:800px;
margin:auto;
margin-bottom:70px;
}

.section-label{
font-size:.9rem;
letter-spacing:3px;
color:#6b7d64;
text-transform:uppercase;
margin-bottom:20px;
}

.offers-header h2{
font-family:'Cormorant Garamond',serif;
font-size:5rem;
color:#233529;
margin-bottom:20px;
}

.title-line{
width:80px;
height:2px;
background:#7f9a76;
margin:auto;
margin-bottom:25px;
}

.offers-subtitle{
font-size:1.15rem;
line-height:1.8;
color:#526156;
}

.offers-grid{
display:grid;
grid-template-columns:repeat(5,1fr);
gap:25px;
}

.offer-card{
background:white;
border-radius:22px;
overflow:hidden;
box-shadow:0 15px 40px rgba(0,0,0,.08);
transition:.35s;
position:relative;
}

.offer-card:hover{
transform:translateY(-10px);
}

.offer-card img{
height:250px;
width:100%;
object-fit:cover;
}

.discount-badge{
position:absolute;
top:18px;
left:18px;
padding:10px 15px;
border-radius:12px;
background:#e87b7b;
color:white;
font-size:.85rem;
font-weight:600;
}

.green{
background:#7e9d70;
}

.blue{
background:#5e8fd8;
}

.orange{
background:#e5944a;
}

.purple{
background:#9b74d8;
}

.offer-content{
padding:25px;
}

.country{
font-size:.8rem;
letter-spacing:2px;
color:#9c8f7b;
font-weight:600;
}

.offer-content h3{
font-family:'Cormorant Garamond',serif;
font-size:2rem;
margin:12px 0;
color:#213126;
}

.offer-content p{
line-height:1.8;
color:#59655d;
margin-bottom:20px;
}

.offer-meta{
display:flex;
flex-direction:column;
gap:10px;
font-size:.9rem;
color:#66736a;
margin-bottom:20px;
}

.offer-footer{
display:flex;
justify-content:space-between;
align-items:center;
padding-top:20px;
border-top:1px solid #ececec;
}

.price{
color:#6d7b70;
}

.price strong{
font-size:1.8rem;
color:#314737;
}

.offer-btn{
padding:12px 22px;
border-radius:50px;
background:#5f7f63;
color:white;
font-weight:600;
transition:.3s;
}

.offer-btn:hover{
background:#46634a;
}

.offers-bottom{
margin-top:60px;
text-align:center;
font-size:1rem;
color:#5d685f;
}

.offers-bottom i{
margin-right:10px;
}

@media(max-width:1400px){

.offers-grid{
grid-template-columns:repeat(3,1fr);
}

}

@media(max-width:992px){

.offers-grid{
grid-template-columns:repeat(2,1fr);
}

.offers-header h2{
font-size:3.5rem;
}

}

@media(max-width:768px){

.offers-grid{
grid-template-columns:1fr;
}

.offers-header h2{
font-size:3rem;
}

}
